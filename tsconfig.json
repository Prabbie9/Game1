{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "noImplicitAny": false, "skipLibCheck": true, "types": ["vite/client"], "noEmit": true, "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["src", "tools/*.ts"]
}
